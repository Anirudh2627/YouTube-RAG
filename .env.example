# ---- LLM (Groq by default; any OpenAI-compatible server works) ----
# Get a key at https://console.groq.com — never commit it.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=                      # override for OpenAI-compatible servers
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# cheap model for query rewriting (falls back to heuristic without a key)
REWRITER_MODEL=llama-3.1-8b-instant
REWRITER_ENABLED=true

# ---- Embeddings ----
EMBEDDING_PROVIDER=sentence-transformers   # or: hashing (offline tests only)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5     # or: BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=32

# ---- Vector store ----
VECTORSTORE_BACKEND=chroma                 # chroma | memory
CHROMA_PERSIST=true

# ---- Retrieval ----
RETRIEVAL_MODE=hybrid                      # vector | bm25 | hybrid
RETRIEVAL_TOP_K=15                         # stage-1 candidates
RERANK_TOP_N=4                             # stage-2 context chunks
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HYBRID_VECTOR_WEIGHT=1.0
HYBRID_BM25_WEIGHT=1.0
RRF_K=60

# ---- Chunking ----
CHUNK_STRATEGY=timestamp                   # timestamp | sentence | token
CHUNK_TARGET_TOKENS=160
CHUNK_MAX_TOKENS=240
CHUNK_OVERLAP_TOKENS=40

# ---- Multimodal (optional; needs ffmpeg + yt-dlp on PATH) ----
MULTIMODAL_FRAMES=false

# ---- YouTube access from blocked IPs (optional) ----
# Netscape-format cookies file for yt-dlp when YouTube blocks your IP:
# YTDLP_COOKIES_FILE=/path/to/cookies.txt

# ---- Misc ----
DEBUG=true
LOG_LEVEL=INFO
CONVERSATION_TTL_MINUTES=120
